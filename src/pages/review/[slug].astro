---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqSection from '../../components/FaqSection.astro';
import { AIRPORTS, getLowestPerGbCost, getAirportReviewTdk } from '../../data/airports';

export function getStaticPaths() {
  return AIRPORTS.map((airport, index) => {
    const prevAirport = index === 0 ? AIRPORTS[AIRPORTS.length - 1] : AIRPORTS[index - 1];
    const nextAirport = index === AIRPORTS.length - 1 ? AIRPORTS[0] : AIRPORTS[index + 1];
    return {
      params: { slug: airport.slug },
      props: { airport, prevAirport, nextAirport, currentIndex: index }
    };
  });
}

const { airport, prevAirport, nextAirport, currentIndex } = Astro.props;
const lowestPerGb = getLowestPerGbCost(airport);
const tdk = getAirportReviewTdk(airport);

// Compare candidates (other airports)
const otherAirports = AIRPORTS.filter((a) => a.slug !== airport.slug);

// Use customFaqs if available, or fallback to default review FAQs
const reviewFaqs = airport.customFaqs && airport.customFaqs.length > 0 
  ? airport.customFaqs 
  : [
      {
        question: `${airport.name}适合什么样的网络环境与使用需求？`,
        answer: `${airport.name}由于采用${airport.lineType}，${airport.tagline}。特别适合：${airport.suitableFor.join('、')}。`
      },
      {
        question: `${airport.name}是否支持月付？有试用套餐吗？`,
        answer: `支持月付，起步套餐月付仅需 ¥${airport.startingPrice} 元。建议新手优先选择月付方案，在不同时间段体验晚高峰与流媒体表现满意后再做长期规划。`
      },
      {
        question: `购买${airport.name}后如何在电脑和手机上使用？`,
        answer: `登录用户中心后可直接复制通用订阅链接，支持导入 Windows (Clash Verge / Sing-box)、Android (v2rayNG / Clash Meta)、iOS (Shadowrocket 小火箭) 及 Mac 客户端。`
      }
    ];

// Product Schema for Bing & Google
const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: tdk.title,
  description: tdk.description,
  brand: {
    '@type': 'Brand',
    name: airport.name
  },
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: airport.scores?.overall || airport.stabilityScore || 9.5,
      bestRating: 10
    },
    author: {
      '@type': 'Organization',
      name: 'VPNTOP 评测室'
    }
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: airport.currency,
    lowPrice: airport.startingPrice,
    offerCount: airport.plans.length
  }
};
---

<BaseLayout
  title={tdk.title}
  description={tdk.description}
  keywords={tdk.keywords}
  schemas={[reviewSchema]}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
    <!-- Breadcrumb -->
    <Breadcrumb
      items={[
        { label: '机场评测', href: '/ranking/overall/' },
        { label: `${airport.name} 深度评测` }
      ]}
    />

    <!-- Header Section -->
    <header class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200">
            {airport.lineType}
          </span>
          {airport.badges?.map((badge) => (
            <span class="px-2 py-0.5 rounded text-xs bg-slate-100 text-slate-700 font-medium">
              {badge}
            </span>
          ))}
        </div>

        <div class="text-xs text-slate-500 flex items-center gap-2">
          <span>数据核验状态：</span>
          <span class="font-semibold text-emerald-700">
            站长亲测 · 真实数据认证 (100%原创证据)
          </span>
          <span>(最后核验: {airport.lastVerified})</span>
        </div>
      </div>

      <!-- H1 -->
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug">
        {airport.name}如何？2026套餐价格、流量节点与晚高峰测速全方位专业评测
      </h1>

      <!-- One-sentence Takeaway -->
      <div class="p-4 rounded-xl bg-brand-50/70 border border-brand-200 text-sm text-brand-950 font-medium">
        <span class="font-bold text-brand-700">一句话评测结论：</span>
        {airport.tagline}，起步价 ¥{airport.startingPrice}/月，折合单GB成本仅约 ¥{lowestPerGb.toFixed(3)}/GB。
      </div>

      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        {airport.description}
      </p>

      <!-- Action buttons -->
      <div class="pt-2 flex flex-wrap items-center gap-3">
        <a
          href={airport.affiliateUrl || airport.officialUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm transition-colors shadow-sm flex items-center gap-1.5"
        >
          <span>访问官方站点与控制台</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a
          href="/compare/"
          class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm transition-colors"
        >
          加入横向比较工具
        </a>
      </div>

      <!-- Webmaster Guarantee & Permanent Coupon Callout -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-3 border-t border-slate-100">
        <div class="flex items-start gap-3 p-4 rounded-xl bg-emerald-50/80 border border-emerald-200">
          <div class="w-8 h-8 rounded-lg bg-emerald-500 text-white flex items-center justify-center shrink-0 font-bold text-sm shadow-sm">
            ✓
          </div>
          <div class="text-xs sm:text-sm">
            <span class="font-bold text-emerald-950 block mb-0.5">站长亲测 · 100%原创真实测试数据</span>
            <p class="text-emerald-800 leading-relaxed text-xs">
              本页面所有核心节点晚高峰测速带宽、延迟抖动、丢包率、4K秒开起播时间与AI/流媒体解锁结果，均为<strong>站长自费购买实机测试所得真实数据</strong>。保留完整原创测试证据与抓包记录，绝非AI虚构或抄袭云测。
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3 p-4 rounded-xl bg-amber-50/80 border border-amber-200">
          <div class="w-8 h-8 rounded-lg bg-amber-500 text-white flex items-center justify-center shrink-0 font-bold text-sm shadow-sm">
            🎫
          </div>
          <div class="text-xs sm:text-sm">
            <span class="font-bold text-amber-950 block mb-0.5">专属优惠券承诺 · 永久有效</span>
            <p class="text-amber-800 leading-relaxed text-xs">
              本站公布的所有机场专属优惠码均为站长直接核验的长期专属特惠福利，<strong>承诺永久有效、无使用期限</strong>！结算时直接输入即可即时享受立减折扣，随时可用。
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Module 1: Comprehensive Radar Scores Breakdown -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-5">
        <div>
          <div class="text-xs font-bold text-brand-600 uppercase tracking-wider mb-1">权威实测审计</div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            VPNTOP 评测室综合能力评分卡
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            基于多入口可用性、晚高峰吞吐、丢包率与风控 IP 解锁全天候监测。
          </p>
        </div>
        <div class="flex items-center gap-3 bg-brand-50 border border-brand-200 px-5 py-3 rounded-2xl shrink-0">
          <div class="text-3xl sm:text-4xl font-black text-brand-700 font-mono">
            {airport.scores?.overall || airport.stabilityScore || 9.5}
          </div>
          <div class="text-xs text-brand-900 leading-tight">
            <div class="font-bold">综合评测分</div>
            <div class="text-brand-600">满分 10.0 分</div>
          </div>
        </div>
      </div>

      <!-- 5-Dimension Progress Bars -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- 稳定性 -->
        <div class="space-y-1.5">
          <div class="flex justify-between text-xs font-semibold text-slate-700">
            <span>⚡ 线路与晚高峰稳定性 (SLA)</span>
            <span class="font-mono text-brand-600">{airport.scores?.stability || 9.8} / 10</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
            <div class="bg-brand-600 h-2.5 rounded-full" style={`width: ${(airport.scores?.stability || 9.8) * 10}%`}></div>
          </div>
        </div>

        <!-- 速度吞吐 -->
        <div class="space-y-1.5">
          <div class="flex justify-between text-xs font-semibold text-slate-700">
            <span>🚀 晚高峰突发带宽与 4K 缓冲响应</span>
            <span class="font-mono text-brand-600">{airport.scores?.speed || 9.7} / 10</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
            <div class="bg-brand-600 h-2.5 rounded-full" style={`width: ${(airport.scores?.speed || 9.7) * 10}%`}></div>
          </div>
        </div>

        <!-- 流媒体与AI解锁 -->
        <div class="space-y-1.5">
          <div class="flex justify-between text-xs font-semibold text-slate-700">
            <span>🤖 ChatGPT / Claude / Netflix 纯净解锁</span>
            <span class="font-mono text-brand-600">{airport.scores?.unlock || 9.8} / 10</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
            <div class="bg-brand-600 h-2.5 rounded-full" style={`width: ${(airport.scores?.unlock || 9.8) * 10}%`}></div>
          </div>
        </div>

        <!-- 性价比指数 -->
        <div class="space-y-1.5">
          <div class="flex justify-between text-xs font-semibold text-slate-700">
            <span>💰 单 GB 净成本与套餐性价比指数</span>
            <span class="font-mono text-brand-600">{airport.scores?.value || 9.6} / 10</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
            <div class="bg-brand-600 h-2.5 rounded-full" style={`width: ${(airport.scores?.value || 9.6) * 10}%`}></div>
          </div>
        </div>

        <!-- 售后响应 -->
        <div class="space-y-1.5 md:col-span-2">
          <div class="flex justify-between text-xs font-semibold text-slate-700">
            <span>🎧 工单响应速度与多平台客户端生态</span>
            <span class="font-mono text-brand-600">{airport.scores?.support || 9.5} / 10</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
            <div class="bg-brand-600 h-2.5 rounded-full" style={`width: ${(airport.scores?.support || 9.5) * 10}%`}></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 2: Brand Background & Network Topology Architecture -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6">
      <div class="border-b border-slate-100 pb-4">
        <div class="text-xs font-bold text-brand-600 uppercase tracking-wider mb-1">硬核拆解</div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          {airport.name} 品牌背景与骨干专线拓扑解析
        </h2>
      </div>

      <div class="text-sm text-slate-700 leading-relaxed space-y-4">
        <p>{airport.brandStory || airport.description}</p>
      </div>

      <!-- 3-Pillar Architecture Diagram -->
      {airport.architecture && (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="bg-slate-50 rounded-xl p-4 border border-slate-200">
            <div class="text-xs font-bold text-slate-500 mb-1">📍 境内接入入口</div>
            <div class="text-sm font-bold text-slate-900 mb-2">BGP 多线智能解析</div>
            <p class="text-xs text-slate-600 leading-relaxed">{airport.architecture.entry}</p>
          </div>
          <div class="bg-brand-50/50 rounded-xl p-4 border border-brand-200">
            <div class="text-xs font-bold text-brand-700 mb-1">⚡ 跨境中继干线</div>
            <div class="text-sm font-bold text-brand-950 mb-2">{airport.lineType} 物理级隔离</div>
            <p class="text-xs text-slate-600 leading-relaxed">{airport.architecture.transit}</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4 border border-slate-200">
            <div class="text-xs font-bold text-slate-500 mb-1">🌐 境外落地网络</div>
            <div class="text-sm font-bold text-slate-900 mb-2">主流核心数据中心</div>
            <p class="text-xs text-slate-600 leading-relaxed">{airport.architecture.exit}</p>
          </div>
        </div>
      )}
    </section>

    <!-- Module 3: Evening Peak Benchmarks Table -->
    {airport.benchmarks && airport.benchmarks.length > 0 && (
      <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-slate-100 pb-4">
          <div>
            <div class="text-xs font-bold text-emerald-600 uppercase tracking-wider mb-1">站长亲测 · 真实数据</div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
              晚高峰（20:00 - 23:00）站长实机测速与丢包审计
            </h2>
            <p class="text-xs text-slate-500 mt-1">
              站长原创实测数据保真：自费订阅多端设备晚高峰连续测速采样，保留原始测速与抓包证据，100%真实数据。
            </p>
          </div>
          <span class="text-xs text-slate-500">测试带宽：千兆物理光纤 · 实测节点：核心骨干</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-50 text-xs font-semibold text-slate-600 border-b border-slate-200">
                <th class="py-3 px-4">测试节点</th>
                <th class="py-3 px-4">物理地区</th>
                <th class="py-3 px-4">平均延迟 (Ping)</th>
                <th class="py-3 px-4">网络抖动 (Jitter)</th>
                <th class="py-3 px-4">晚高峰丢包率</th>
                <th class="py-3 px-4">峰值下载带宽</th>
                <th class="py-3 px-4">4K起播缓冲</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {airport.benchmarks.map((bench) => (
                <tr class="hover:bg-slate-50">
                  <td class="py-3 px-4 font-bold text-slate-900 whitespace-nowrap">{bench.nodeName}</td>
                  <td class="py-3 px-4 text-slate-600 whitespace-nowrap">{bench.region}</td>
                  <td class="py-3 px-4 font-mono font-semibold text-emerald-700 whitespace-nowrap">{bench.avgPing}</td>
                  <td class="py-3 px-4 font-mono text-slate-600 whitespace-nowrap">{bench.jitter}</td>
                  <td class="py-3 px-4 font-mono font-bold text-emerald-600 whitespace-nowrap">{bench.packetLoss}</td>
                  <td class="py-3 px-4 font-mono font-bold text-brand-600 whitespace-nowrap">{bench.peakBandwidth}</td>
                  <td class="py-3 px-4 text-xs text-slate-600 whitespace-nowrap">{bench.bufferTime}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="text-xs text-slate-500 pt-2 flex items-center gap-1.5">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>站长原创实测声明：以上数据由站长自费购买并于晚高峰（20:00-23:00）真实实机抓包测速，保留完整原始测试证据，拒绝虚假宣传。</span>
        </div>
      </section>
    )}

    <!-- Module 4: Plan Pricing Table -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-4 shadow-sm">
      <div class="flex items-baseline justify-between border-b border-slate-100 pb-4">
        <div>
          <div class="text-xs font-bold text-brand-600 uppercase tracking-wider mb-1">资费明细 · 优惠码长期有效</div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
            最新全周期套餐价格与真实每GB成本表
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            数据来源：服务商公开控制台最新公示，币种：人民币 (CNY) · <strong class="text-amber-700">★ 提示：本站所有专属优惠券均永久有效，结账输入优惠码直接享受立减</strong>
          </p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-50 text-xs font-semibold text-slate-500 border-b border-slate-200">
              <th class="py-3 px-4">套餐名称</th>
              <th class="py-3 px-4">周期价格</th>
              <th class="py-3 px-4">月度可用流量</th>
              <th class="py-3 px-4">折合单GB成本</th>
              <th class="py-3 px-4">特色权益与权益说明</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {airport.plans.map((plan) => {
              const perGb = plan.billingCycle === 'annual' 
                ? plan.price / (plan.trafficGb * 12)
                : plan.price / plan.trafficGb;

              return (
                <tr class="hover:bg-slate-50">
                  <td class="py-3.5 px-4 font-bold text-slate-900">
                    {plan.name}
                  </td>
                  <td class="py-3.5 px-4 font-bold text-brand-600">
                    ¥{plan.price}
                    <span class="text-xs font-normal text-slate-500">
                      {plan.billingCycle === 'monthly' ? '/月' : plan.billingCycle === 'annual' ? '/年' : ' 一次性'}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 font-medium text-slate-700">
                    {plan.trafficGb} GB
                  </td>
                  <td class="py-3.5 px-4 font-mono text-xs text-slate-600 font-bold">
                    ¥{perGb.toFixed(3)} / GB
                  </td>
                  <td class="py-3.5 px-4 text-xs text-slate-600">
                    {plan.features?.join(' · ') || '标准专线权限'}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Module 5: Node & Technical Specifications + AI Streaming Unlock -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Specs Card -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-4 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-2 flex items-center gap-2">
          <span>🛠️ 节点网络与技术规格</span>
        </h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between py-1 border-b border-slate-50">
            <dt class="text-slate-500">传输线路类型</dt>
            <dd class="font-semibold text-slate-800">{airport.lineType}</dd>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-50">
            <dt class="text-slate-500">SLA可用率承诺</dt>
            <dd class="font-semibold text-slate-800">{airport.slaGuarantee || '99.5% 专线保障'}</dd>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-50">
            <dt class="text-slate-500">协议支持</dt>
            <dd class="font-semibold text-slate-800">{airport.protocols.join(', ')}</dd>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-50">
            <dt class="text-slate-500">同时在线设备限制</dt>
            <dd class="font-semibold text-slate-800">{airport.deviceLimit}</dd>
          </div>
          <div class="flex justify-between py-1">
            <dt class="text-slate-500">覆盖主要地区</dt>
            <dd class="font-semibold text-slate-800">{airport.regions.join('、')}</dd>
          </div>
        </dl>
      </div>

      <!-- AI & Streaming Unlock Card -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-4 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-2 flex items-center gap-2">
          <span>🌐 AI模型与流媒体解锁能力</span>
        </h2>
        <div class="space-y-3 text-sm">
          <div>
            <span class="text-xs font-semibold text-slate-500 block mb-1">支持的 AI 生产力服务：</span>
            <div class="flex flex-wrap gap-1.5">
              {airport.aiSupport?.map((ai) => (
                <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 text-xs font-medium border border-emerald-200">
                  ✓ {ai}
                </span>
              ))}
            </div>
          </div>
          <div class="pt-2">
            <span class="text-xs font-semibold text-slate-500 block mb-1">支持的 4K 流媒体平台：</span>
            <div class="flex flex-wrap gap-1.5">
              {airport.streamingSupport?.map((st) => (
                <span class="px-2 py-0.5 rounded bg-sky-50 text-sky-800 text-xs font-medium border border-sky-200">
                  ✓ {st}
                </span>
              ))}
            </div>
          </div>
          {airport.unlockReport && (
            <div class="pt-3 border-t border-slate-100 text-xs text-slate-600 leading-relaxed">
              <strong>IP 纯净度评估：</strong>{airport.unlockReport.chatgpt}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Module 6: Client Setup Guide -->
    {airport.clientGuide && (
      <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <div class="text-xs font-bold text-brand-600 uppercase tracking-wider mb-1">实操向导</div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
            {airport.name} 客户端导入与规则分流最佳实践
          </h2>
        </div>
        <p class="text-sm text-slate-700 leading-relaxed">
          {airport.clientGuide}
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs">
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-center">
            <div class="font-bold text-slate-800">Windows</div>
            <div class="text-slate-500 mt-1">Clash Verge Rev / Sing-box</div>
          </div>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-center">
            <div class="font-bold text-slate-800">macOS</div>
            <div class="text-slate-500 mt-1">Surge / Sing-box</div>
          </div>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-center">
            <div class="font-bold text-slate-800">iOS</div>
            <div class="text-slate-500 mt-1">Shadowrocket / Loon</div>
          </div>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-center">
            <div class="font-bold text-slate-800">Android</div>
            <div class="text-slate-500 mt-1">v2rayNG / Flclash</div>
          </div>
        </div>
      </section>
    )}

    <!-- Module 7: Pros and Cons Analysis -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Pros -->
      <div class="bg-emerald-50/50 rounded-2xl border border-emerald-200 p-6 space-y-3 shadow-sm">
        <h2 class="text-lg font-bold text-emerald-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          核心优势深度剖析
        </h2>
        <ul class="space-y-2 text-sm text-slate-700">
          {airport.advantages.map((adv) => (
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">•</span>
              <span>{adv}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Cons -->
      <div class="bg-amber-50/50 rounded-2xl border border-amber-200 p-6 space-y-3 shadow-sm">
        <h2 class="text-lg font-bold text-amber-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          缺点与实测注意事项
        </h2>
        <ul class="space-y-2 text-sm text-slate-700">
          {airport.disadvantages.map((dis) => (
            <li class="flex items-start gap-2">
              <span class="text-amber-600 font-bold">•</span>
              <span>{dis}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Module 8: Suitable Audience & Pre-purchase Precautions -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-4 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-3">
        适合人群与购买前核验建议
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-slate-600">
        <div>
          <h3 class="font-bold text-slate-800 mb-2">强烈推荐以下人群选择：</h3>
          <ul class="space-y-2 list-disc list-inside">
            {airport.suitableFor.map((aud) => (
              <li class="leading-relaxed">{aud}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-slate-800 mb-2">购买前必读防坑建议：</h3>
          <p class="leading-relaxed text-xs sm:text-sm">
            初次体验请坚持选择“月付套餐”。避免单次直接充值超长期限。同时根据所在宽带（电信/联通/移动）测试主要节点的握手延迟。支持客户端测速筛选低延迟节点。
          </p>
        </div>
      </div>
    </section>

    <!-- Module 9: Editorial Verdict & CTA Banner -->
    <section class="bg-gradient-to-br from-brand-950 via-slate-900 to-brand-900 rounded-2xl p-6 sm:p-10 text-white shadow-lg space-y-5">
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-brand-500/30 border border-brand-400 text-brand-300 text-xs font-bold">
          🏆 VPNTOP 评测室终审决议
        </span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight leading-snug">
        总结裁决：{airport.name} 是否值得购买？
      </h2>
      <p class="text-sm sm:text-base text-slate-200 leading-relaxed max-w-3xl">
        {airport.verdictSummary || `${airport.name}在${airport.lineType}领域表现扎实，起步价格亲民且晚高峰抗丢包能力强，是目前值得重点考虑的高素质服务商。`}
      </p>
      <div class="pt-2 flex flex-wrap items-center gap-4">
        <a
          href={airport.affiliateUrl || airport.officialUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="px-6 py-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-bold text-sm transition-all shadow-md hover:shadow-lg flex items-center gap-2"
        >
          <span>前往官网选购体验 &rarr;</span>
        </a>
        <a
          href="/compare/"
          class="px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-all border border-white/20"
        >
          与其他机场横向对比
        </a>
      </div>
    </section>

    <!-- Module 10: Related Airport Comparison -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-slate-900">
        横向对比：其他备选服务商
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {otherAirports.slice(0, 3).map((other) => (
          <a
            href={`/review/${other.slug}/`}
            class="p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-400 transition-all flex flex-col justify-between shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="font-bold text-slate-800">{other.name}</span>
                <span class="text-brand-600 font-semibold">¥{other.startingPrice}/月起</span>
              </div>
              <p class="text-xs text-slate-500 line-clamp-2 mt-1">{other.tagline}</p>
            </div>
            <div class="mt-3 text-xs text-brand-600 font-medium">查看对比评测 &rarr;</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Module 11: Airport Review Prev & Next Navigation -->
    <nav aria-label="机场评测上下篇导航" class="pt-6 border-t border-slate-200">
      <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3 flex items-center justify-between">
        <span>14家品牌横向连续评测 (当前第 {currentIndex + 1} / {AIRPORTS.length} 家)</span>
        <a href="/ranking/overall/" class="text-brand-600 hover:underline">查看完整排行榜 &rarr;</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Prev Airport -->
        <a
          href={`/review/${prevAirport.slug}/`}
          class="group p-4 rounded-xl border border-slate-200 hover:border-brand-500 hover:bg-brand-50/30 transition-all flex flex-col justify-between bg-white shadow-xs"
        >
          <div class="flex items-center gap-1.5 text-xs text-slate-400 group-hover:text-brand-600 font-semibold mb-2">
            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>上一家评测：{prevAirport.name}</span>
          </div>
          <div class="text-sm font-bold text-slate-800 group-hover:text-brand-600 line-clamp-1 leading-snug">
            {prevAirport.name} · {prevAirport.lineType} · ¥{prevAirport.startingPrice}/月起
          </div>
        </a>

        <!-- Next Airport -->
        <a
          href={`/review/${nextAirport.slug}/`}
          class="group p-4 rounded-xl border border-slate-200 hover:border-brand-500 hover:bg-brand-50/30 transition-all flex flex-col justify-between sm:text-right bg-white shadow-xs"
        >
          <div class="flex items-center sm:justify-end gap-1.5 text-xs text-slate-400 group-hover:text-brand-600 font-semibold mb-2">
            <span>下一家评测：{nextAirport.name}</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
          <div class="text-sm font-bold text-slate-800 group-hover:text-brand-600 line-clamp-1 leading-snug">
            {nextAirport.name} · {nextAirport.lineType} · ¥{nextAirport.startingPrice}/月起
          </div>
        </a>
      </div>
    </nav>

    <!-- Module 12: Detailed Brand FAQ -->
    <FaqSection
      title={`${airport.name} 常见疑问深度解答 (FAQ)`}
      description="基于用户真实咨询、网络实测与日常售后经验汇总解答。"
      items={reviewFaqs}
    />

    <!-- Data Transparency -->
    <div class="text-xs text-slate-500 bg-slate-100/70 p-4 rounded-xl space-y-1 leading-relaxed">
      <div class="font-bold text-slate-700">数据来源与免责披露：</div>
      <p>• 本文数据来源于：{airport.sources.join('、')}。</p>
      <p>• 评测测试状态：{airport.testStatus === 'tested' ? 'VPNTOP实验室实测' : '官方核实资料'}。最后核验时间：{airport.lastVerified}。</p>
      <p>• 严禁将网络代理用于任何违法违规行为。服务商价格以官方控制台实时变动为准。</p>
    </div>
  </div>
</BaseLayout>
