---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { AIRPORTS } from '../../data/airports';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  // Sort guides chronologically by updateDate descending
  guides.sort((a, b) => new Date(b.data.updateDate).getTime() - new Date(a.data.updateDate).getTime());

  return guides.map((guide, index) => {
    // Circular Previous and Next
    const prevGuide = index === 0 ? guides[guides.length - 1] : guides[index - 1];
    const nextGuide = index === guides.length - 1 ? guides[0] : guides[index + 1];

    // Related guides: same platform first, then other platforms
    const samePlatform = guides.filter((g) => g.slug !== guide.slug && g.data.platform === guide.data.platform);
    const otherPlatform = guides.filter((g) => g.slug !== guide.slug && g.data.platform !== guide.data.platform);
    const relatedGuides = [...samePlatform, ...otherPlatform].slice(0, 3);

    return {
      params: { slug: guide.slug },
      props: { guide, prevGuide, nextGuide, relatedGuides, allCount: guides.length },
    };
  });
}

const { guide, prevGuide, nextGuide, relatedGuides, allCount } = Astro.props;
const { Content } = await guide.render();

// Matched recommended airports
const recommended = AIRPORTS.filter((a) => guide.data.recommendedAirports.includes(a.id));

// Schema.org TechArticle
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.publishDate,
  dateModified: guide.data.updateDate,
  author: {
    '@type': 'Organization',
    name: guide.data.author,
  },
};
---

<BaseLayout
  title={`${guide.data.metaTitle || guide.data.title} - VPNTOP`}
  description={guide.data.description}
  ogType="article"
  publishDate={guide.data.publishDate}
  updateDate={guide.data.updateDate}
  schemas={[articleSchema]}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumb
      items={[
        { label: '使用教程', href: '/guides/' },
        { label: `${guide.data.platform.toUpperCase()} 教程`, href: '/guides/' },
        { label: guide.data.title }
      ]}
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Article (8 cols) -->
      <article class="lg:col-span-8 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm">
        <header class="border-b border-slate-100 pb-6 mb-8 space-y-3">
          <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <span class="px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 font-semibold uppercase">
              {guide.data.platform} 平台
            </span>
            <span>•</span>
            <span>更新于：{guide.data.updateDate}</span>
            <span>•</span>
            <span>作者：{guide.data.author}</span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
            {guide.data.title}
          </h1>

          <p class="text-sm sm:text-base text-slate-600 leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-100">
            {guide.data.description}
          </p>
        </header>

        <!-- Markdown Content -->
        <div class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-brand-600 hover:prose-a:underline prose-img:rounded-xl">
          <Content />
        </div>

        <!-- In-Article Action Banner -->
        <div class="mt-10 p-5 bg-gradient-to-r from-brand-50/80 via-white to-brand-50/50 rounded-2xl border border-brand-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="space-y-1 text-center sm:text-left">
            <div class="text-sm font-bold text-slate-900">✈️ 还没有导入可用的机场节点订阅？</div>
            <p class="text-xs text-slate-600">本教程兼容全协议节点。建议搭配低延迟、无视敏感期的专线服务商体验。</p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-2 shrink-0">
            <a href="/ranking/overall/" class="px-3.5 py-2 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs rounded-xl shadow-xs transition-colors">
              🏆 挑选专线节点
            </a>
            <a href="/compare/" class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-xl border border-slate-200 shadow-xs transition-colors">
              ⚖️ 机场参数对比
            </a>
          </div>
        </div>

        <!-- Guide Prev & Next Navigation (上下篇无缝跳转) -->
        <nav aria-label="教程上下篇导航" class="mt-8 pt-6 border-t border-slate-200">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3 flex items-center justify-between">
            <span>教程前后切换</span>
            <a href="/guides/" class="text-brand-600 hover:underline">返回教程总览 ({allCount}篇) &rarr;</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Prev Guide -->
            <a
              href={`/guides/${prevGuide.slug}/`}
              class="group p-4 rounded-xl border border-slate-200 hover:border-brand-500 hover:bg-brand-50/30 transition-all flex flex-col justify-between bg-white shadow-xs"
            >
              <div class="flex items-center gap-1.5 text-xs text-slate-400 group-hover:text-brand-600 font-semibold mb-2">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span>上一篇教程</span>
              </div>
              <div class="text-sm font-bold text-slate-800 group-hover:text-brand-600 line-clamp-2 leading-snug">
                {prevGuide.data.title}
              </div>
            </a>

            <!-- Next Guide -->
            <a
              href={`/guides/${nextGuide.slug}/`}
              class="group p-4 rounded-xl border border-slate-200 hover:border-brand-500 hover:bg-brand-50/30 transition-all flex flex-col justify-between sm:text-right bg-white shadow-xs"
            >
              <div class="flex items-center sm:justify-end gap-1.5 text-xs text-slate-400 group-hover:text-brand-600 font-semibold mb-2">
                <span>下一篇教程</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
              <div class="text-sm font-bold text-slate-800 group-hover:text-brand-600 line-clamp-2 leading-snug">
                {nextGuide.data.title}
              </div>
            </a>
          </div>
        </nav>

        <!-- Related Guides Section (相关进阶教程) -->
        <section class="mt-8 p-6 bg-slate-50/80 rounded-2xl border border-slate-200/80">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-brand-600 rounded-full"></span>
              <span>相关实操教程推荐</span>
            </h3>
            <a href="/guides/" class="text-xs font-semibold text-brand-600 hover:underline">查看全部教程 &rarr;</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {relatedGuides.map((g) => (
              <a
                href={`/guides/${g.slug}/`}
                class="p-4 bg-white rounded-xl border border-slate-200 hover:border-brand-400 hover:shadow-xs transition-all group flex flex-col justify-between"
              >
                <div>
                  <span class="text-[11px] font-semibold text-slate-700 bg-slate-100 px-2 py-0.5 rounded uppercase">
                    {g.data.platform}
                  </span>
                  <h4 class="text-xs font-bold text-slate-800 group-hover:text-brand-600 line-clamp-2 mt-2 leading-snug">
                    {g.data.title}
                  </h4>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                  <span>更新：{g.data.updateDate}</span>
                  <span class="text-brand-600 font-medium group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </article>

      <!-- Sidebar (4 cols) -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- Recommended Airports Card -->
        {recommended.length > 0 && (
          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-1.5">
              <span>✈️ 本教程适配的推荐机场</span>
            </h3>
            <div class="space-y-3">
              {recommended.map((airport) => (
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs space-y-1.5">
                  <div class="flex items-center justify-between font-bold text-slate-800">
                    <a href={`/review/${airport.slug}/`} class="hover:text-brand-600">{airport.name}</a>
                    <span class="text-brand-600">¥{airport.startingPrice}/月起</span>
                  </div>
                  <p class="text-slate-500 line-clamp-1">{airport.tagline}</p>
                  <div class="flex items-center justify-between pt-1">
                    <span class="text-[11px] text-slate-400">{airport.lineType}</span>
                    <a href={`/review/${airport.slug}/`} class="text-brand-600 font-medium hover:underline">查看评测 &rarr;</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Quick Links Card -->
        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-5 space-y-3 text-xs">
          <h3 class="font-bold text-slate-900">核心指南与工具</h3>
          <ul class="space-y-2 text-slate-600">
            <li><a href="/ranking/overall/" class="hover:text-brand-600 flex items-center justify-between"><span>🏆 2026综合实力排行榜</span><span class="text-slate-400">&rarr;</span></a></li>
            <li><a href="/ranking/value/" class="hover:text-brand-600 flex items-center justify-between"><span>💰 极致性价比排行榜</span><span class="text-slate-400">&rarr;</span></a></li>
            <li><a href="/compare/" class="hover:text-brand-600 flex items-center justify-between"><span>⚖️ 机场参数横向对比器</span><span class="text-slate-400">&rarr;</span></a></li>
            <li><a href="/glossary/node-multiplier/" class="hover:text-brand-600 flex items-center justify-between"><span>❓ 什么是节点倍率计算？</span><span class="text-slate-400">&rarr;</span></a></li>
            <li><a href="/blog/" class="hover:text-brand-600 flex items-center justify-between"><span>📰 100篇科学上网避坑资讯</span><span class="text-slate-400">&rarr;</span></a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
