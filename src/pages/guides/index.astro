---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');
allGuides.sort((a, b) => new Date(b.data.updateDate).getTime() - new Date(a.data.updateDate).getTime());

const platformLabels: Record<string, string> = {
  windows: 'Windows',
  android: 'Android',
  ios: 'iOS / iPad',
  macos: 'macOS',
  router: '软路由 OpenWrt',
  tv: '电视 TV',
  linux: 'Linux 服务器',
  general: '通用技巧'
};

// Platforms summary
const platformCounts = allGuides.reduce((acc, guide) => {
  acc[guide.data.platform] = (acc[guide.data.platform] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const platforms = Object.keys(platformCounts);
---

<BaseLayout
  title="教程中心 - 多平台客户端使用教程大全 (Windows/Android/iOS/Mac/软路由) - VPNTOP"
  description="VPNTOP教程中心：汇聚全平台科学上网客户端使用教程，图文手把手教你导入节点订阅、开启TUN虚拟网卡与配置智能分流。包含Clash Verge、Sing-box、小火箭、v2rayNG及软路由全套实操指南。"
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumb items={[{ label: '教程中心' }]} />

    <!-- Header Section matching Image 1 -->
    <header class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-brand-600 mb-1">教程中心</div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
            多平台客户端使用教程
          </h1>
          <p class="text-sm text-slate-500 mt-1 max-w-3xl">
            图文手把手教你导入节点订阅、开启TUN虚拟网卡与配置智能分流。全网 {allGuides.length} 篇主流客户端实操指南已全部收录。
          </p>
        </div>
        <div class="shrink-0 flex items-center gap-2">
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
            30 篇保姆级教程全覆盖
          </span>
        </div>
      </div>

      <!-- Platform Filter Pills -->
      <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center gap-2" id="platform-filter-group">
        <button
          type="button"
          data-filter="all"
          class="plat-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition-all bg-brand-600 text-white shadow-xs"
        >
          全部教程 ({allGuides.length})
        </button>
        {platforms.map((plat) => (
          <button
            type="button"
            data-filter={plat}
            class="plat-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 text-slate-700 hover:bg-brand-50 hover:text-brand-600"
          >
            {platformLabels[plat] || plat} ({platformCounts[plat]})
          </button>
        ))}
      </div>
    </header>

    <!-- 4-Column Card Grid matching Image 1 layout -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="guides-container">
      {allGuides.map((guide) => (
        <article
          data-platform={guide.data.platform}
          class="guide-card bg-white rounded-xl border border-slate-200 p-4 hover:border-brand-400 hover:shadow-sm transition-all group flex flex-col justify-between"
        >
          <div>
            <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-700 font-bold text-xs uppercase mb-3 group-hover:bg-brand-50 group-hover:text-brand-600 transition-colors">
              {guide.data.platform}
            </div>
            <h2 class="text-sm font-bold text-slate-900 group-hover:text-brand-600 transition-colors line-clamp-2 leading-snug">
              <a href={`/guides/${guide.slug}/`}>
                {guide.data.title}
              </a>
            </h2>
            <p class="text-xs text-slate-500 mt-1.5 line-clamp-2 leading-relaxed">
              {guide.data.description}
            </p>
          </div>

          <div class="mt-3 pt-2 border-t border-slate-100/70 flex items-center justify-between text-[11px] text-brand-600 font-medium">
            <a href={`/guides/${guide.slug}/`} class="hover:underline flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>阅读详细指南</span>
              <span>&rarr;</span>
            </a>
            <span class="text-slate-400 text-[10px]">{guide.data.updateDate}</span>
          </div>
        </article>
      ))}
    </div>
  </div>

  <script>
    const filterBtns = document.querySelectorAll('.plat-filter-btn');
    const cards = document.querySelectorAll('.guide-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active button styles
        filterBtns.forEach(b => {
          b.classList.remove('bg-brand-600', 'text-white', 'shadow-xs');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-brand-600', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        // Filter cards
        cards.forEach(card => {
          const plat = card.getAttribute('data-platform');
          if (filter === 'all' || plat === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
