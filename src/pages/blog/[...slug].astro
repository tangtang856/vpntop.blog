---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { AIRPORTS } from '../../data/airports';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Sort posts chronologically by publishDate descending
  posts.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

  return posts.map((post, index) => {
    // Circular Previous and Next
    const prevPost = index === 0 ? posts[posts.length - 1] : posts[index - 1];
    const nextPost = index === posts.length - 1 ? posts[0] : posts[index + 1];

    // Related posts: same category first, then fill from others
    const sameCat = posts.filter((p) => p.slug !== post.slug && p.data.category === post.data.category);
    const otherCat = posts.filter((p) => p.slug !== post.slug && p.data.category !== post.data.category);
    const relatedPosts = [...sameCat, ...otherCat].slice(0, 3);

    return {
      params: { slug: post.slug },
      props: { post, prevPost, nextPost, relatedPosts, allCount: posts.length },
    };
  });
}

const { post, prevPost, nextPost, relatedPosts, allCount } = Astro.props;
const { Content } = await post.render();

// Schema.org BlogPosting
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate,
  dateModified: post.data.updateDate,
  author: {
    '@type': 'Organization',
    name: post.data.author,
  },
};
---

<BaseLayout
  title={`${post.data.metaTitle || post.data.title} - VPNTOP`}
  description={post.data.description}
  ogType="article"
  publishDate={post.data.publishDate}
  updateDate={post.data.updateDate}
  schemas={[articleSchema]}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumb
      items={[
        { label: '资讯博客', href: '/blog/' },
        { label: post.data.category, href: '/blog/' },
        { label: post.data.title }
      ]}
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Content (8 cols) -->
      <article class="lg:col-span-8 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm">
        <header class="border-b border-slate-100 pb-6 mb-8 space-y-3">
          <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <span class="px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 font-semibold">
              {post.data.category}
            </span>
            <span>•</span>
            <span>发布日期：{post.data.publishDate}</span>
            <span>•</span>
            <span>更新于：{post.data.updateDate}</span>
            <span>•</span>
            <span>作者：{post.data.author}</span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
            {post.data.title}
          </h1>

          <p class="text-sm sm:text-base text-slate-600 leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-100">
            {post.data.description}
          </p>
        </header>

        <!-- Markdown Content -->
        <div class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-brand-600 hover:prose-a:underline prose-img:rounded-xl">
          <Content />
        </div>

        <!-- In-Article Quick Nav Action Banner -->
        <div class="mt-10 p-5 bg-gradient-to-r from-brand-50/80 via-white to-brand-50/50 rounded-2xl border border-brand-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="space-y-1 text-center sm:text-left">
            <div class="text-sm font-bold text-slate-900">🚀 正在寻找稳定不折腾的优质梯子机场？</div>
            <p class="text-xs text-slate-600">已严格测试 14 家主流服务商的晚高峰丢包率与 ChatGPT / 流媒体解锁表现。</p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-2 shrink-0">
            <a href="/ranking/overall/" class="px-3.5 py-2 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs rounded-xl shadow-xs transition-colors">
              🏆 综合实力榜
            </a>
            <a href="/compare/" class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-xl border border-slate-200 shadow-xs transition-colors">
              ⚖️ 机场对比器
            </a>
            <a href="/guides/" class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-xl border border-slate-200 shadow-xs transition-colors">
              📖 教程中心
            </a>
          </div>
        </div>

        <!-- Article Prev & Next Navigation (上下篇无缝跳转) -->
        <nav aria-label="文章上下篇导航" class="mt-8 pt-6 border-t border-slate-200">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3 flex items-center justify-between">
            <span>文章前后切换</span>
            <a href="/blog/" class="text-brand-600 hover:underline">返回博客总览 ({allCount}篇) &rarr;</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Prev Post -->
            <a
              href={`/blog/${prevPost.slug}/`}
              class="group p-4 rounded-xl border border-slate-200 hover:border-brand-500 hover:bg-brand-50/30 transition-all flex flex-col justify-between bg-white shadow-xs"
            >
              <div class="flex items-center gap-1.5 text-xs text-slate-400 group-hover:text-brand-600 font-semibold mb-2">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span>上一篇文章</span>
              </div>
              <div class="text-sm font-bold text-slate-800 group-hover:text-brand-600 line-clamp-2 leading-snug">
                {prevPost.data.title}
              </div>
            </a>

            <!-- Next Post -->
            <a
              href={`/blog/${nextPost.slug}/`}
              class="group p-4 rounded-xl border border-slate-200 hover:border-brand-500 hover:bg-brand-50/30 transition-all flex flex-col justify-between sm:text-right bg-white shadow-xs"
            >
              <div class="flex items-center sm:justify-end gap-1.5 text-xs text-slate-400 group-hover:text-brand-600 font-semibold mb-2">
                <span>下一篇文章</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
              <div class="text-sm font-bold text-slate-800 group-hover:text-brand-600 line-clamp-2 leading-snug">
                {nextPost.data.title}
              </div>
            </a>
          </div>
        </nav>

        <!-- Related Posts Section (相关延伸阅读) -->
        <section class="mt-8 p-6 bg-slate-50/80 rounded-2xl border border-slate-200/80">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-brand-600 rounded-full"></span>
              <span>猜你想读 · 相关深度推荐</span>
            </h3>
            <a href="/blog/" class="text-xs font-semibold text-brand-600 hover:underline">更多文章 &rarr;</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {relatedPosts.map((p) => (
              <a
                href={`/blog/${p.slug}/`}
                class="p-4 bg-white rounded-xl border border-slate-200 hover:border-brand-400 hover:shadow-xs transition-all group flex flex-col justify-between"
              >
                <div>
                  <span class="text-[11px] font-semibold text-brand-700 bg-brand-50 px-2 py-0.5 rounded">
                    {p.data.category}
                  </span>
                  <h4 class="text-xs font-bold text-slate-800 group-hover:text-brand-600 line-clamp-2 mt-2 leading-snug">
                    {p.data.title}
                  </h4>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                  <span>{p.data.publishDate}</span>
                  <span class="text-brand-600 font-medium group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </article>

      <!-- Sidebar (4 cols) -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- Featured Airport Card -->
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-3 text-xs">
          <h3 class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
            <span>💡 编辑部精选专线机场</span>
          </h3>
          <p class="text-slate-500 leading-relaxed">
            如需稳定不掉线的 IEPL 专线，推荐参考本站实验室最新核验：
          </p>
          <div class="space-y-2 pt-1">
            {AIRPORTS.slice(0, 3).map((a) => (
              <a href={`/review/${a.slug}/`} class="block p-3 rounded-xl bg-slate-50 border border-slate-100 hover:border-brand-300 transition-colors">
                <div class="flex items-center justify-between font-bold text-slate-800">
                  <span>{a.name}</span>
                  <span class="text-brand-600">¥{a.startingPrice}/月起</span>
                </div>
                <div class="text-slate-400 text-[11px] mt-1">{a.lineType} · {a.tagline}</div>
              </a>
            ))}
          </div>
          <div class="pt-2 text-right">
            <a href="/ranking/overall/" class="text-brand-600 font-semibold hover:underline">
              查看全部 14 家机场排行 &rarr;
            </a>
          </div>
        </div>

        <!-- Quick Links Card -->
        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-5 space-y-3 text-xs">
          <h3 class="font-bold text-slate-900 text-sm">热门专区与工具直达</h3>
          <ul class="space-y-2 text-slate-600">
            <li><a href="/ranking/overall/" class="hover:text-brand-600 flex items-center justify-between"><span>🏆 综合实力排行榜</span><span class="text-slate-400">&rarr;</span></a></li>
            <li><a href="/ranking/value/" class="hover:text-brand-600 flex items-center justify-between"><span>💰 极致性价比榜单</span><span class="text-slate-400">&rarr;</span></a></li>
            <li><a href="/ranking/stable/" class="hover:text-brand-600 flex items-center justify-between"><span>🛡️ 高稳定防断联榜</span><span class="text-slate-400">&rarr;</span></a></li>
            <li><a href="/compare/" class="hover:text-brand-600 flex items-center justify-between"><span>⚖️ 机场参数横向对比</span><span class="text-slate-400">&rarr;</span></a></li>
            <li><a href="/guides/" class="hover:text-brand-600 flex items-center justify-between"><span>📖 全平台配置教程库</span><span class="text-slate-400">&rarr;</span></a></li>
            <li><a href="/glossary/" class="hover:text-brand-600 flex items-center justify-between"><span>📚 科学上网术语百科</span><span class="text-slate-400">&rarr;</span></a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
