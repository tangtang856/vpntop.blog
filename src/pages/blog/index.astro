---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const allBlog = await getCollection('blog');
allBlog.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<BaseLayout
  title="博客与科学上网行业观察 - VPNTOP"
  description="VPNTOP行业资讯与选购指南：深入探讨VPN与机场差异、协议演进、机场跑路成本揭秘、ChatGPT与Claude风控排查等深度原创内容。"
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumb items={[{ label: '资讯博客' }]} />

    <header class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-semibold">
        <span>📰 深度观察</span>
        <span>•</span>
        <span>原创干货</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        网络资讯与科学上网深度观察博客
      </h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-3xl">
        立足一线技术实践与行业客观调查，带你穿透营销迷雾，搞清协议底层原理、成本结构与排障方案。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allBlog.map((post) => (
        <article class="bg-white rounded-2xl border border-slate-200 p-6 hover:border-brand-400 hover:shadow-md transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
              <span class="px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 font-semibold">
                {post.data.category}
              </span>
              <span>{post.data.publishDate}</span>
            </div>
            <h2 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors line-clamp-2">
              <a href={`/blog/${post.slug}/`}>
                {post.data.title}
              </a>
            </h2>
            <p class="text-xs text-slate-500 mt-2 line-clamp-3 leading-relaxed">
              {post.data.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs text-slate-400">作者：{post.data.author}</span>
            <a
              href={`/blog/${post.slug}/`}
              class="text-xs font-semibold text-brand-600 hover:text-brand-700 flex items-center gap-1"
            >
              <span>阅读全文</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
