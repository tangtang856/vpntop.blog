---
import { NAV_ITEMS, SITE } from '../site.config';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="site-logo w-9 h-9 rounded-xl overflow-hidden shadow-sm group-hover:shadow-md group-hover:scale-105 transition-all duration-200 shrink-0" style="width: 36px; height: 36px; min-width: 36px; min-height: 36px; max-width: 36px; max-height: 36px;">
          <svg width="36" height="36" viewBox="0 0 100 100" class="w-9 h-9 block" style="width: 36px; height: 36px;" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="headerLogoBg" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#1e3a8a" />
                <stop offset="50%" stop-color="#2563eb" />
                <stop offset="100%" stop-color="#0284c7" />
              </linearGradient>
              <linearGradient id="headerLeftWing" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#0284c7" />
              </linearGradient>
              <linearGradient id="headerRightWing" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="100%" stop-color="#e0f2fe" />
              </linearGradient>
              <linearGradient id="headerCoreBeam" x1="50%" y1="0%" x2="50%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="100%" stop-color="#38bdf8" />
              </linearGradient>
              <filter id="headerLogoShadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#0b132b" flood-opacity="0.45" />
              </filter>
            </defs>
            <rect width="100" height="100" rx="26" fill="url(#headerLogoBg)" />
            <rect x="1.5" y="1.5" width="97" height="97" rx="24.5" stroke="rgba(255, 255, 255, 0.28)" stroke-width="2" fill="none" />
            <g filter="url(#headerLogoShadow)">
              <path d="M50 18 L21 73 C19 77 23 81 27 79 L50 65 Z" fill="url(#headerLeftWing)" />
              <path d="M50 18 L79 73 C81 77 77 81 73 79 L50 65 Z" fill="url(#headerRightWing)" />
              <path d="M50 20 L53.5 56 L50 62 L46.5 56 Z" fill="url(#headerCoreBeam)" />
              <path d="M50 70 L34 81 C32 82 35 85 38 83.5 L50 76 L62 83.5 C65 85 68 82 66 81 Z" fill="#38bdf8" opacity="0.95" />
            </g>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold text-slate-900 tracking-tight leading-none group-hover:text-brand-600 transition-colors">
            VPNTOP<span class="text-brand-600">.blog</span>
          </span>
          <span class="text-[11px] text-slate-500 font-medium tracking-wider mt-0.5">
            机场推荐与VPN节点评测
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        {NAV_ITEMS.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          const hasChildren = item.children && item.children.length > 0;

          return (
            <div class="relative group">
              <a
                href={item.href}
                class={`px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-1 ${
                  isActive
                    ? 'text-brand-600 bg-brand-50 font-semibold'
                    : 'text-slate-700 hover:text-brand-600 hover:bg-slate-50'
                }`}
              >
                {item.label}
                {hasChildren && (
                  <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-brand-600 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              {hasChildren && (
                <div class={`absolute ${item.label === '教程中心' ? 'right-0' : 'left-0'} top-full pt-2 w-64 hidden group-hover:block transition-all duration-150`}>
                  <div class="bg-white rounded-xl shadow-xl border border-slate-100 p-2 overflow-hidden ring-1 ring-black/5">
                    {item.children?.map((sub) => (
                      <a
                        href={sub.href}
                        class="block px-3 py-2.5 rounded-lg hover:bg-slate-50 transition-colors group/sub"
                      >
                        <div class="text-sm font-medium text-slate-800 group-hover/sub:text-brand-600">
                          {sub.label}
                        </div>
                        {sub.desc && (
                          <div class="text-xs text-slate-500 mt-0.5 line-clamp-1">
                            {sub.desc}
                          </div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- Right Action / Mobile Toggle -->
      <div class="flex items-center gap-2.5">
        <a
          href="/compare/"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 rounded-full border border-brand-200 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          机场对比器
        </a>

        <!-- Contact Popover Container -->
        <div class="relative" id="contact-popover-container">
          <button
            type="button"
            id="contact-btn"
            aria-expanded="false"
            aria-haspopup="true"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-white bg-gradient-to-r from-brand-600 to-sky-600 hover:from-brand-700 hover:to-sky-700 rounded-full shadow-sm hover:shadow transition-all group"
          >
            <svg class="w-3.5 h-3.5 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <span>联络我们</span>
            <svg class="w-3 h-3 text-white/80 transition-transform duration-200" id="contact-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Contact Popover Panel -->
          <div
            id="contact-panel"
            class="hidden absolute right-0 top-full mt-2 w-[340px] sm:w-[380px] bg-white rounded-2xl shadow-2xl border border-slate-200/90 p-5 z-50 text-left transition-all duration-200 ring-1 ring-black/5"
            role="dialog"
            aria-label="联系我们方式详情"
          >
            <!-- Panel Header -->
            <div class="border-b border-slate-100 pb-3 mb-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <h3 class="text-sm font-bold text-slate-900">官方商务与技术支持</h3>
                </div>
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-medium border border-emerald-200">
                  站长在线响应
                </span>
              </div>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                欢迎提交机场评测送测、商业合作洽谈、测速数据复核或科学上网技术咨询。
              </p>
            </div>

            <!-- Contact Channels -->
            <div class="space-y-3">
              <!-- Telegram Channel -->
              <div class="p-3.5 rounded-xl bg-slate-50 hover:bg-sky-50/60 border border-slate-200/80 hover:border-sky-300 transition-all group/item">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-start gap-3">
                    <div class="w-9 h-9 rounded-xl bg-[#229ED9] text-white flex items-center justify-center shrink-0 shadow-sm">
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.458c.538-.196 1.006.128.832.943z"/>
                      </svg>
                    </div>
                    <div>
                      <div class="text-xs font-semibold text-slate-500">即时沟通 · 官方 Telegram</div>
                      <div class="text-sm font-bold text-slate-900 group-hover/item:text-[#229ED9] transition-colors flex items-center gap-1.5 mt-0.5">
                        <span>@xintangtang</span>
                      </div>
                      <div class="text-[11px] text-slate-500 mt-0.5">
                        商务合作洽谈 / 紧急测速复核 / 节点报障
                      </div>
                    </div>
                  </div>
                </div>

                <div class="mt-3 pt-2.5 border-t border-slate-200/60 flex items-center gap-2">
                  <a
                    href="https://t.me/xintangtang"
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class="flex-1 py-1.5 px-3 rounded-lg bg-[#229ED9] hover:bg-[#1d8bc0] text-white font-medium text-xs text-center transition-colors shadow-sm flex items-center justify-center gap-1"
                  >
                    <span>打开 Telegram 私聊</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  <button
                    type="button"
                    class="copy-contact-btn py-1.5 px-2.5 rounded-lg bg-white hover:bg-slate-100 text-slate-700 text-xs font-medium border border-slate-200 transition-colors shrink-0"
                    data-copy="@xintangtang"
                    title="复制 Telegram 用户名"
                  >
                    复制 ID
                  </button>
                </div>
              </div>

              <!-- Gmail Channel -->
              <div class="p-3.5 rounded-xl bg-slate-50 hover:bg-rose-50/60 border border-slate-200/80 hover:border-rose-300 transition-all group/item">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-start gap-3">
                    <div class="w-9 h-9 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0 shadow-sm">
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L12 9.545l8.073-6.052C21.69 2.28 24 3.434 24 5.457z"/>
                      </svg>
                    </div>
                    <div>
                      <div class="text-xs font-semibold text-slate-500">官方邮箱 · Google Mail</div>
                      <div class="text-xs sm:text-sm font-bold text-slate-900 group-hover/item:text-rose-600 transition-colors mt-0.5 break-all">
                        xintangtang888@gmail.com
                      </div>
                      <div class="text-[11px] text-slate-500 mt-0.5">
                        深度投稿方案 / 商务公函 / 评测纠错
                      </div>
                    </div>
                  </div>
                </div>

                <div class="mt-3 pt-2.5 border-t border-slate-200/60 flex items-center gap-2">
                  <a
                    href="mailto:xintangtang888@gmail.com"
                    class="flex-1 py-1.5 px-3 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs text-center transition-colors shadow-sm flex items-center justify-center gap-1"
                  >
                    <span>发送 Gmail 邮件</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </a>
                  <button
                    type="button"
                    class="copy-contact-btn py-1.5 px-2.5 rounded-lg bg-white hover:bg-slate-100 text-slate-700 text-xs font-medium border border-slate-200 transition-colors shrink-0"
                    data-copy="xintangtang888@gmail.com"
                    title="复制 Gmail 邮箱地址"
                  >
                    复制邮箱
                  </button>
                </div>
              </div>
            </div>

            <!-- Footer Service Promise -->
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                工作日 2 小时内快速响应
              </span>
              <span>100% 严格保护隐私</span>
            </div>
          </div>
        </div>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="打开网站导航菜单"
          class="lg:hidden p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="menu-icon-bars">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="menu-icon-close">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white">
    <div class="px-4 pt-2 pb-6 space-y-1 divide-y divide-slate-100 max-h-[80vh] overflow-y-auto">
      {NAV_ITEMS.map((item) => (
        <div class="py-2">
          <a
            href={item.href}
            class="block px-3 py-2 text-base font-semibold text-slate-900 rounded-md hover:bg-slate-50"
          >
            {item.label}
          </a>
          {item.children && (
            <div class="pl-4 mt-1 space-y-1">
              {item.children.map((sub) => (
                <a
                  href={sub.href}
                  class="block px-3 py-1.5 text-sm text-slate-600 hover:text-brand-600 hover:bg-brand-50 rounded"
                >
                  {sub.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-4 px-3 flex flex-col gap-2">
        <a
          href="/compare/"
          class="w-full text-center py-2 px-4 bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-lg text-sm transition-colors"
        >
          打开机场横向对比工具
        </a>

        <!-- Mobile Contact Block -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/90 space-y-2 mt-2">
          <div class="text-xs font-bold text-slate-800 flex items-center justify-between">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              官方商务与技术支持
            </span>
            <span class="text-[10px] text-emerald-700 font-medium">站长在线</span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs pt-1">
            <a
              href="https://t.me/xintangtang"
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="py-2 px-2.5 rounded-lg bg-[#229ED9] hover:bg-[#1d8bc0] text-white font-medium text-center flex items-center justify-center gap-1 shadow-sm transition-colors"
            >
              <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.458c.538-.196 1.006.128.832.943z"/>
              </svg>
              <span>TG: @xintangtang</span>
            </a>
            <a
              href="mailto:xintangtang888@gmail.com"
              class="py-2 px-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-medium text-center flex items-center justify-center gap-1 shadow-sm transition-colors"
            >
              <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L12 9.545l8.073-6.052C21.69 2.28 24 3.434 24 5.457z"/>
              </svg>
              <span>Gmail 邮件发信</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = menu.classList.toggle('hidden');
      if (iconBars && iconClose) {
        iconBars.classList.toggle('hidden', !isExpanded);
        iconClose.classList.toggle('hidden', isExpanded);
      }
    });
  }

  // Contact Us Popover logic
  const contactBtn = document.getElementById('contact-btn');
  const contactPanel = document.getElementById('contact-panel');
  const contactArrow = document.getElementById('contact-arrow');
  const contactContainer = document.getElementById('contact-popover-container');

  if (contactBtn && contactPanel) {
    contactBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = contactPanel.classList.toggle('hidden');
      contactBtn.setAttribute('aria-expanded', String(!isHidden));
      if (contactArrow) {
        contactArrow.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
      }
    });

    document.addEventListener('click', (e) => {
      if (contactContainer && !contactContainer.contains(e.target as Node)) {
        contactPanel.classList.add('hidden');
        contactBtn.setAttribute('aria-expanded', 'false');
        if (contactArrow) contactArrow.style.transform = 'rotate(0deg)';
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        contactPanel.classList.add('hidden');
        contactBtn.setAttribute('aria-expanded', 'false');
        if (contactArrow) contactArrow.style.transform = 'rotate(0deg)';
      }
    });
  }

  // Copy contact info to clipboard
  document.querySelectorAll<HTMLButtonElement>('.copy-contact-btn').forEach((copyBtn) => {
    copyBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const text = copyBtn.getAttribute('data-copy');
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const originalText = copyBtn.textContent;
        copyBtn.textContent = '已复制 ✓';
        copyBtn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
        setTimeout(() => {
          copyBtn.textContent = originalText;
          copyBtn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
        }, 2000);
      } catch (err) {
        prompt('请手动复制联系方式：', text);
      }
    });
  });
</script>
