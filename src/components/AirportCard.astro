---
import type { Airport } from '../data/airports';
import { getLowestPerGbCost } from '../data/airports';

interface Props {
  airport: Airport;
  featured?: boolean;
}

const { airport, featured = false } = Astro.props;

const lowestPerGb = getLowestPerGbCost(airport);
const firstPlan = airport.plans[0];
---

<article class={`bg-white rounded-2xl border transition-all duration-200 overflow-hidden shadow-sm ${
  featured 
    ? 'border-brand-300 shadow-md ring-1 ring-brand-100 hover:shadow-lg' 
    : 'border-slate-200 hover:shadow-md hover:border-slate-300'
}`}>
  <!-- Top bar / badges -->
  <div class="px-6 pt-6 pb-4">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
          airport.lineType.includes('专线')
            ? 'bg-purple-100 text-purple-800 border border-purple-200'
            : 'bg-blue-100 text-blue-800 border border-blue-200'
        }`}>
          {airport.lineType}
        </span>
        {airport.badges?.map((badge) => (
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-slate-100 text-slate-700">
            {badge}
          </span>
        ))}
      </div>

      <!-- Verification Status -->
      <span class={`text-xs inline-flex items-center gap-1 font-medium ${
        airport.testStatus === 'tested' 
          ? 'text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200'
          : airport.testStatus === 'official-data'
          ? 'text-sky-700 bg-sky-50 px-2 py-0.5 rounded border border-sky-200'
          : 'text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200'
      }`}>
        <span class={`w-1.5 h-1.5 rounded-full ${
          airport.testStatus === 'tested' ? 'bg-emerald-500' : airport.testStatus === 'official-data' ? 'bg-sky-500' : 'bg-amber-500'
        }`}></span>
        {airport.testStatus === 'tested' ? '实验室实测' : airport.testStatus === 'official-data' ? '官方核实资料' : '尚未完全核实'}
      </span>
    </div>

    <!-- Header & Price -->
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
      <div>
        <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-600">
          <a href={`/review/${airport.slug}/`} class="hover:text-brand-600 transition-colors">
            {airport.name}
          </a>
        </h3>
        <p class="text-sm text-slate-600 mt-1 line-clamp-2">
          {airport.tagline}
        </p>
      </div>

      <div class="sm:text-right shrink-0 mt-2 sm:mt-0">
        <div class="text-xs text-slate-500">起步套餐</div>
        <div class="flex items-baseline gap-1 sm:justify-end">
          <span class="text-2xl font-extrabold text-brand-600">¥{airport.startingPrice}</span>
          <span class="text-xs text-slate-500 font-normal">/ 月起</span>
        </div>
        {lowestPerGb > 0 && (
          <div class="text-[11px] text-slate-400">
            折合约 ¥{lowestPerGb.toFixed(3)} / GB
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Specs grid -->
  <div class="px-6 py-3 bg-slate-50/70 border-y border-slate-100 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-slate-600">
    <div>
      <span class="block text-slate-400">基础流量</span>
      <span class="font-semibold text-slate-800">{firstPlan ? `${firstPlan.trafficGb} GB / 月` : '按量计费'}</span>
    </div>
    <div>
      <span class="block text-slate-400">协议支持</span>
      <span class="font-semibold text-slate-800 truncate block" title={airport.protocols.join(', ')}>
        {airport.protocols.slice(0, 2).join(', ')}{airport.protocols.length > 2 ? '等' : ''}
      </span>
    </div>
    <div>
      <span class="block text-slate-400">设备限制</span>
      <span class="font-semibold text-slate-800 truncate block" title={airport.deviceLimit}>
        {airport.deviceLimit}
      </span>
    </div>
    <div>
      <span class="block text-slate-400">核心节点</span>
      <span class="font-semibold text-slate-800 truncate block">
        {airport.regions.slice(0, 3).join('/')}
      </span>
    </div>
  </div>

  <!-- Advantages & Precautions -->
  <div class="px-6 py-4 space-y-3">
    <!-- Pros -->
    <div>
      <div class="text-xs font-semibold text-emerald-800 mb-1.5 flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        主要优势
      </div>
      <ul class="text-xs text-slate-600 space-y-1">
        {airport.advantages.slice(0, 2).map((adv) => (
          <li class="flex items-start gap-1.5">
            <span class="text-emerald-500 font-bold">•</span>
            <span class="line-clamp-1">{adv}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Cons / Precautions -->
    {airport.disadvantages.length > 0 && (
      <div>
        <div class="text-xs font-semibold text-amber-800 mb-1 flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          购买注意事项
        </div>
        <p class="text-xs text-slate-500 line-clamp-1 pl-4">
          {airport.disadvantages[0]}
        </p>
      </div>
    )}

    <!-- Target user tags -->
    <div class="pt-2 flex flex-wrap gap-1.5">
      <span class="text-[11px] text-slate-400 self-center">适合：</span>
      {airport.suitableFor.slice(0, 3).map((target) => (
        <span class="text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded">
          {target}
        </span>
      ))}
    </div>
  </div>

  <!-- Actions -->
  <div class="px-6 pb-6 pt-2 flex flex-col sm:flex-row items-center gap-2.5">
    <a
      href={`/review/${airport.slug}/`}
      class="w-full sm:flex-1 text-center py-2.5 px-4 bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-xl text-sm transition-colors shadow-sm"
    >
      查看完整评测与套餐
    </a>
    <a
      href={airport.affiliateUrl || airport.officialUrl}
      target="_blank"
      rel="noopener noreferrer nofollow"
      class="w-full sm:w-auto text-center py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl text-sm transition-colors flex items-center justify-center gap-1"
    >
      <span>官网直达</span>
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</article>
