---
import { FOOTER_LINKS, SITE } from '../site.config';
---

<footer class="relative z-10 bg-slate-900 text-slate-300 mt-auto border-t border-slate-800">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Col 1: Brand Info -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="site-footer-logo w-8 h-8 rounded-xl overflow-hidden shadow-sm shrink-0" style="width: 32px; height: 32px; min-width: 32px; min-height: 32px; max-width: 32px; max-height: 32px;">
            <svg width="32" height="32" viewBox="0 0 100 100" class="w-8 h-8 block" style="width: 32px; height: 32px;" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="footerLogoBg" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#1e3a8a" />
                  <stop offset="50%" stop-color="#2563eb" />
                  <stop offset="100%" stop-color="#0284c7" />
                </linearGradient>
                <linearGradient id="footerLeftWing" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#38bdf8" />
                  <stop offset="100%" stop-color="#0284c7" />
                </linearGradient>
                <linearGradient id="footerRightWing" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="100%" stop-color="#e0f2fe" />
                </linearGradient>
                <linearGradient id="footerCoreBeam" x1="50%" y1="0%" x2="50%" y2="100%">
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="100%" stop-color="#38bdf8" />
                </linearGradient>
              </defs>
              <rect width="100" height="100" rx="26" fill="url(#footerLogoBg)" />
              <rect x="1.5" y="1.5" width="97" height="97" rx="24.5" stroke="rgba(255, 255, 255, 0.28)" stroke-width="2" fill="none" />
              <g>
                <path d="M50 18 L21 73 C19 77 23 81 27 79 L50 65 Z" fill="url(#footerLeftWing)" />
                <path d="M50 18 L79 73 C81 77 77 81 73 79 L50 65 Z" fill="url(#footerRightWing)" />
                <path d="M50 20 L53.5 56 L50 62 L46.5 56 Z" fill="url(#footerCoreBeam)" />
                <path d="M50 70 L34 81 C32 82 35 85 38 83.5 L50 76 L62 83.5 C65 85 68 82 66 81 Z" fill="#38bdf8" opacity="0.95" />
              </g>
            </svg>
          </div>
          <span class="text-xl font-bold text-white tracking-tight">
            VPNTOP<span class="text-brand-400">.blog</span>
          </span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          VPNTOP 是专注于网络基础设施、IEPL专线机场与VPN梯子节点的中文第三方独立资讯门户。我们通过透明的套餐参数比对、客观评测与技术教程，帮助读者做出理性的科学上网工具选择。
        </p>
        <div class="flex items-center gap-2 text-xs text-slate-400 pt-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>数据基准：每月15日定期核验与更新</span>
        </div>
      </div>

      <!-- Col 2: Topics -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">
          热门专题
        </h3>
        <ul class="space-y-2.5 text-sm">
          {FOOTER_LINKS.topics.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Guides -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">
          客户端教程
        </h3>
        <ul class="space-y-2.5 text-sm">
          {FOOTER_LINKS.guides.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Trust & Policies -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">
          网站政策与信任
        </h3>
        <ul class="space-y-2.5 text-sm">
          {FOOTER_LINKS.legal.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Editorial Disclaimer & Affiliate Disclosure -->
    <div class="mt-12 pt-8 border-t border-slate-800 text-xs text-slate-400 space-y-3 leading-relaxed">
      <p>
        <strong class="text-slate-300">免责声明与合规声明：</strong>
        本网站所载信息仅供网络技术学习、跨国科研学术研究、开源开发以及合法跨境商业活动参考。请读者严格遵守所在国家及地区的法律法规，切勿将相关技术用于任何非法或危害网络安全的行为。
      </p>
      <p>
        <strong class="text-slate-300">商业与联盟推广披露 (Affiliate Disclosure)：</strong>
        VPNTOP 秉承客观独立性原则。为了维持服务器与评测测试开销，网站部分链接可能包含推广返利代码（Affiliate Link）。返利不会改变用户的购买价格，亦不会影响我们基于真实数据对各机场优缺点的客观评述。未经验证的服务商绝不收录。
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {new Date().getFullYear()} VPNTOP.blog - All rights reserved. 专为高质量 Bing 搜索打造的机场资讯站.</p>
      <div class="flex items-center gap-4">
        <a href="/sitemap-index.xml" class="hover:text-slate-400">XML Sitemap</a>
        <span>•</span>
        <a href="/editorial-policy/" class="hover:text-slate-400">评测准则</a>
        <span>•</span>
        <a href="/privacy-policy/" class="hover:text-slate-400">隐私与Cookie</a>
      </div>
    </div>
  </div>
</footer>
