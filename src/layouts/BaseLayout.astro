---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonical?: string;
  ogType?: 'website' | 'article';
  publishDate?: string;
  updateDate?: string;
  noindex?: boolean;
  schemas?: Record<string, any>[];
}

const {
  title = `${SITE.name} - 2026最新优质机场推荐与VPN节点评测指南`,
  description = SITE.description,
  keywords = SITE.keywords,
  canonical,
  ogType = 'website',
  publishDate,
  updateDate,
  noindex = false,
  schemas = [],
} = Astro.props;

// Compute clean canonical URL with trailing slash
const is404 = Astro.url.pathname.includes('404');
const currentPath = is404 ? '/404.html' : (Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`);
const canonicalUrl = canonical || (is404 ? `${SITE.url}/404.html` : `${SITE.url}${currentPath}`);

// Structured data for WebSite and Organization
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.fullName,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/favicon.svg`,
  },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.fullName,
  alternateName: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/favicon.svg`,
  foundingDate: `${SITE.foundingYear}-01-01`,
};
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon-v2.svg" />
    <link rel="shortcut icon" href="/images/favicon-v2.svg" />
    <link rel="apple-touch-icon" href="/images/favicon-v2.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={SITE.author} />

    <!-- Robots Meta for Bing & Search Engines -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    <!-- Bing Webmaster Verification -->
    <meta name="msvalidate.01" content="VPNTOP_BING_VERIFICATION_TOKEN" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={`${SITE.url}/images/og-default.svg`} />
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {updateDate && <meta property="article:modified_time" content={updateDate} />}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/images/og-default.svg`} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb" />

    <!-- Global JSON-LD Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="text-slate-800 antialiased selection:bg-brand-100 selection:text-brand-900 flex flex-col min-h-screen relative overflow-x-hidden">
    <!-- Full-Page Global Animated Water-Ink Canvas (全网页动态水墨背景) -->
    <div class="global-ink-stage" aria-hidden="true">
      <!-- 1. Ultra HD Moving Landscape Canvas -->
      <div class="global-ink-bg"></div>

      <!-- 2. Clean Ambient Contrast Wash -->
      <div class="global-ink-wash"></div>

      <!-- 3. Animated Rising Red Sun Radiance -->
      <div class="global-ink-sun"></div>

      <!-- 4. Drifting Mountain Mist Layers -->
      <div class="global-ink-mist-1"></div>
      <div class="global-ink-mist-2"></div>

      <!-- 5. Soaring Flying Cranes / Birds Flock Across Entire Screen -->
      <div class="global-ink-birds">
        <div class="ink-bird ink-bird-1">
          <svg viewBox="0 0 40 24" fill="currentColor">
            <path d="M 0 12 Q 10 2 20 10 Q 30 2 40 12 Q 30 6 20 11 Q 10 6 0 12 Z" />
          </svg>
        </div>
        <div class="ink-bird ink-bird-2">
          <svg viewBox="0 0 40 24" fill="currentColor">
            <path d="M 0 12 Q 10 2 20 10 Q 30 2 40 12 Q 30 6 20 11 Q 10 6 0 12 Z" />
          </svg>
        </div>
        <div class="ink-bird ink-bird-3">
          <svg viewBox="0 0 40 24" fill="currentColor">
            <path d="M 0 12 Q 10 2 20 10 Q 30 2 40 12 Q 30 6 20 11 Q 10 6 0 12 Z" />
          </svg>
        </div>
        <div class="ink-bird ink-bird-4">
          <svg viewBox="0 0 40 24" fill="currentColor">
            <path d="M 0 12 Q 10 2 20 10 Q 30 2 40 12 Q 30 6 20 11 Q 10 6 0 12 Z" />
          </svg>
        </div>
        <div class="ink-bird ink-bird-5">
          <svg viewBox="0 0 40 24" fill="currentColor">
            <path d="M 0 12 Q 10 2 20 10 Q 30 2 40 12 Q 30 6 20 11 Q 10 6 0 12 Z" />
          </svg>
        </div>
      </div>
    </div>

    <Header currentPath={currentPath} />

    <main class="flex-grow relative z-10">
      <slot />
    </main>

    <Footer />
  </body>
</html>
